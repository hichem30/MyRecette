# ---------------------------------------------------------------------------
# Public (browser-safe) — must be prefixed NEXT_PUBLIC_
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase ------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Stripe (publishable) ------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ---------------------------------------------------------------------------
# Server-only — never expose to the browser
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Admin bootstrap email(s) — comma-separated list. Any user who signs up
# with one of these emails is automatically promoted to admin on first
# login. Use this for the initial 1-2 site owners; additional admins can
# then be promoted from the dashboard at /admin/staff.
# Example: ADMIN_BOOTSTRAP_EMAIL=owner@example.com,manager@example.com
ADMIN_BOOTSTRAP_EMAIL=youremail@example.com
