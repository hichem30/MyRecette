{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shop",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Public env vars (NEXT_PUBLIC_*) and ADMIN_BOOTSTRAP_EMAIL live here so
  // every `wrangler deploy` re-applies them. Secrets
  // (SUPABASE_SERVICE_ROLE_KEY, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET)
  // are set in the Cloudflare dashboard under Variables and Secrets;
  // those are stored separately and survive deploys.
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://shop.redbarnmarket.workers.dev",
    "NEXT_PUBLIC_SUPABASE_URL": "https://fjngynjzktxclcvpsbtk.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZqbmd5bmp6a3R4Y2xjdnBzYnRrIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzg3NzA4ODAsImV4cCI6MjA5NDM0Njg4MH0.yjxocIdBQuH3mFaKxfG_nsqBdGL9-4w1h2USttWRhpw",
    "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY": "pk_test_51TXJ7yICIZJg9BDtv9Y4vr9Fa3uiqB2edgbf7QzjUMiHpeV3ec7wN2oYqyDGNA2HGbpdWyE6UX3AlaN1VPqYhM1s00TR3iscl6",
    "ADMIN_BOOTSTRAP_EMAIL": "redbarnmarket@protonmail.com"
  }
  // To enable the OpenNext ISR cache on Cloudflare KV (recommended on
  // the free plan — keeps worker CPU < 10ms per cached page request),
  // create a namespace once:
  //   npx wrangler kv namespace create NEXT_INC_CACHE_KV
  // then paste the returned id below and re-deploy:
  // ,"kv_namespaces": [
  //   { "binding": "NEXT_INC_CACHE_KV", "id": "<paste-id-here>" }
  // ]
}
