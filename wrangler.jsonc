{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sucre-et-sel",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-07",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Public env vars (NEXT_PUBLIC_*) and ADMIN_BOOTSTRAP_EMAIL live here so
  // every `wrangler deploy` re-applies them. Secrets
  // (SUPABASE_SERVICE_ROLE_KEY, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET)
  // are set in the Cloudflare dashboard under Variables and Secrets;
  // those are stored separately and survive deploys.
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://sucre-et-sel.sucre-et-sel.workers.dev",
    "NEXT_PUBLIC_SUPABASE_URL": "https://rjfcbdjyymspwasgrvts.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InJqZmNiZGp5eW1zcHdhc2dydnRzIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODMzNzAyNjIsImV4cCI6MjA5ODk0NjI2Mn0.R0-J-fS-RFYUiv4C5X9YDA6mRcU-2Si2xy-bii58Kdg",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_qmGijOvnqNTjctPTS7ncDQ_0UEJ_eqE",
    "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY": "pk_test_51Tn1a4AX2w8dlVHiLvmhbDiFeZaL1AqNjIArXVZ77axX2zJ0f0fPDR9vd5nyokw2UQKF96CdMHk8aOiQgaVG539G00FZ143Z9y",
    "ADMIN_BOOTSTRAP_EMAIL": "hichemjouili2@gmail.com"
  },
  "kv_namespaces": []
  // OpenNext ISR cache via Cloudflare KV is currently DISABLED. The free
  // plan caps KV bulk writes at 1k/day and a single deploy uploads ~115
  // keys, so several deploys per day fail with code 10048. open-next.config
  // now uses `dummyIncrementalCache` instead — pages render on demand
  // without any KV writes.
  //
  // To re-enable (recommended once you upgrade to Workers Paid — $5/mo,
  // no KV write cap):
  //   1. Switch `dummyIncrementalCache` back to `kvIncrementalCache` in
  //      open-next.config.ts.
  //   2. Un-comment the `kv_namespaces` block below.
  //   3. Re-deploy. (Re-create the KV namespace if it has been deleted:
  //      `npx wrangler kv namespace create NEXT_INC_CACHE_KV`)
  // "kv_namespaces": [
  //   { "binding": "NEXT_INC_CACHE_KV", "id": "398d8f4e6c2d449eb60ff08274477f9b" }
  // ]
}
